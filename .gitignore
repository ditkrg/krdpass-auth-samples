# Ignore generated Xcode workspaces, but tunnel down to the native iOS sample's
# resolved SPM graph (an app should commit it for reproducible builds; a library should not).
**/*.xcworkspace
!ios/demo-krdpass-auth.xcodeproj/project.xcworkspace/
!ios/demo-krdpass-auth.xcodeproj/project.xcworkspace/xcshareddata/
!ios/demo-krdpass-auth.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
# The Flutter template's own workspace is checked in upstream and is what
# `flutter build ios` opens; without it a clean clone cannot build.
!flutter/ios/Runner.xcworkspace/
!flutter/ios/Runner.xcworkspace/contents.xcworkspacedata
**/*.xcuserdata
DerivedData/

