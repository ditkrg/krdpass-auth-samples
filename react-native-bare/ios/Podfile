# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'KrdpassAuthBare' do
  # CocoaPods cannot express this git source through the SDK podspec alone.
  #
  # A tag is mutable. CocoaPods records only :git and :tag in Podfile.lock's
  # CHECKOUT OPTIONS, and its SPEC CHECKSUMS hash covers the podspec text rather
  # than the checked-out source, so retagging v1.4.0 at a different commit is
  # undetectable here. A production integration should pin the commit as well:
  #
  #   pod 'KrdpassAuth', :git => 'https://github.com/ditkrg/krdpass-auth-sdk-ios.git',
  #                      :commit => '<full 40-character sha>'
  #
  # (:tag and :commit are mutually exclusive; :commit alone is the tamper-evident one.)
  pod 'KrdpassAuth', :git => 'https://github.com/ditkrg/krdpass-auth-sdk-ios.git', :tag => 'v1.4.0'

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
