source 'https://rubygems.org'

# Active Support's supported security-fix line requires Ruby 3.1 or newer.
ruby ">= 3.1.0"

# Xcode 16 and newer require the matching CocoaPods/xcodeproj pair.
gem 'cocoapods', '1.16.2'
gem 'activesupport', '>= 7.2.3.1', '< 8'
gem 'xcodeproj', '1.27.0'
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
gem 'tsort'
