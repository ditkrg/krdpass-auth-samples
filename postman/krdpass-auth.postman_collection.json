            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeChallenge\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeChallengeMethod\": \"S256\",\n  \"state\": \"validation-check-authserver\",\n  \"environment\": \"{{environment}}\",\n  \"redirectUri\": \"{{redirectUri}}\",\n  \"authServerUrl\": \"https://attacker.example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
