            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeChallenge\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeChallengeMethod\": \"plain\",\n  \"state\": \"validation-check-method\",\n  \"environment\": \"{{environment}}\",\n  \"redirectUri\": \"{{redirectUri}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
