              "mode": "raw",
              "raw": "{\n  \"codeChallenge\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeChallengeMethod\": \"S256\",\n  \"state\": \"validation-check-environment\",\n  \"environment\": \"staging\",\n  \"redirectUri\": \"{{redirectUri}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
