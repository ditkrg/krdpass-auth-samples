            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeChallenge\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeChallengeMethod\": \"S256\",\n  \"state\": \"validation-check-redirect\",\n  \"environment\": \"{{environment}}\",\n  \"redirectUri\": \"https://not-allowlisted.example.com/callback\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PAR rejects an authServerUrl override",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 400 invalid_request', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql('invalid_request');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
