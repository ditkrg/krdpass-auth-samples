              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeChallenge\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n  \"codeChallengeMethod\": \"S256\",\n  \"state\": \"validation-check-scope\",\n  \"environment\": \"{{environment}}\",\n  \"redirectUri\": \"{{redirectUri}}\",\n  \"scope\": \"profile\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
