# Local-only secrets/config for running ALL examples (gitignored).
# Copy to: shared/secrets/.env
#
# IMPORTANT:
# - Never commit shared/secrets/.env
# - CLIENT_SECRET and RSA_PRIVATE_KEY must ONLY go to the server (.env) output.
#
# Sync commands:
# - All platforms:     ./scripts/sync-secrets.sh
# - Android only:      ./scripts/sync-secrets-android.sh
# - iOS only:          ./scripts/sync-secrets-ios.sh

# -----------------------------------------------------------------------------
# Public-ish app config (safe to be used by client examples)
# -----------------------------------------------------------------------------
BACKEND_URL=https://your-backend.example.com
REDIRECT_URI=https://your-backend.example.com/_krdpass/oauth/callback
CLIENT_ID=your-client-id
KRD_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server secrets (required for server)
# -----------------------------------------------------------------------------
CLIENT_SECRET=your-oauth-client-secret
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# Server hardening (recommended)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed redirect hosts for /oauth/par and /oauth/token
# Note: sync script always appends REDIRECT_URI host to this list automatically.
ALLOWED_REDIRECT_HOSTS=your-backend.example.com

# -----------------------------------------------------------------------------
# Demo extras (optional): serve AASA + assetlinks from server
# -----------------------------------------------------------------------------
DEMO_EXTRAS=true

# iOS Universal Links (required if DEMO_EXTRAS=true)
# Preferred (supports multiple apps):
# DEMO_IOS_APP_IDS=YOUR_TEAM_ID.krd.pass.auth.demo
DEMO_IOS_TEAM_ID=YOUR_TEAM_ID
DEMO_IOS_BUNDLE_ID=krd.pass.auth.demo

# Android App Links (required if DEMO_EXTRAS=true)
#
# Preferred (supports multiple apps): comma-separated `package|SHA256` pairs.
# Example:
# DEMO_ANDROID_APP_LINKS=krd.pass.auth.demo|AF:39:...
DEMO_ANDROID_PACKAGE_NAME=krd.pass.auth.demo
DEMO_ANDROID_SHA256=00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF

# -----------------------------------------------------------------------------
# Android signing: leave unset to use shared demo keystore (created on first sync)
# -----------------------------------------------------------------------------
# ANDROID_KEYSTORE_PATH=/absolute/path/to/your.keystore
# ANDROID_KEYSTORE_ALIAS=your_alias
# ANDROID_KEYSTORE_PASSWORD=your_store_password
# ANDROID_KEYSTORE_PRIVATE_KEY_PASSWORD=your_key_password

# -----------------------------------------------------------------------------
# Optional: control whether sync-secrets patches tracked demo project files.
# Default is true for easy local testing.
# -----------------------------------------------------------------------------
# PATCH_TRACKED_DEMO_FILES=true
# Set to false only if you want to keep tracked files untouched.

# Optional: default target when running ./scripts/sync-secrets.sh without flags.
# Valid values: all, android, ios
# KRD_SYNC_TARGET=all
