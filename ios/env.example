# NOTE: the KRD_REDIRECT_URI host MUST equal the Associated Domains applinks host
# in demo-krdpass-auth.entitlements, and that host must serve a valid
# /.well-known/apple-app-site-association, otherwise the Universal Link callback
# opens Safari and sign-in never returns to the app.
KRD_BACKEND_URL=https://your-backend.example.com
KRD_REDIRECT_URI=https://your-backend.example.com/_krdpass/oauth/callback
KRD_CLIENT_ID=your-client-id
KRD_ENVIRONMENT=development
