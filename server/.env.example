# Server Configuration (Optional)
HOST=127.0.0.1
PORT=3000

# OAuth Server Configuration (Required)
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret

# RSA Private Key (Required - paste entire PEM content)
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Demo Extras (Optional - set to 'true' to enable iOS Universal Links support)
DEMO_EXTRAS=false

# iOS Universal Links Configuration (Required if DEMO_EXTRAS=true)
# Preferred multi-app format (comma-separated):
# DEMO_IOS_APP_IDS=YOUR_TEAM_ID.krd.pass.auth.demo
DEMO_IOS_TEAM_ID=YOUR_TEAM_ID
DEMO_IOS_BUNDLE_ID=krd.pass.auth.demo

# Android App Links Configuration (Required if DEMO_EXTRAS=true)
# Preferred multi-app format (comma-separated package|SHA256 pairs):
# DEMO_ANDROID_APP_LINKS=krd.pass.auth.demo|00:11:...
DEMO_ANDROID_PACKAGE_NAME=krd.pass.auth.demo
DEMO_ANDROID_SHA256=00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF

# Optional security hardening: comma-separated redirect hosts allowlist
ALLOWED_REDIRECT_HOSTS=auth.myapp.gov.krd
